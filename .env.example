# Qloo hackathon key. Hackathon keys only work against the hackathon host.
# Without a key the app runs in SAMPLE mode and says so on every screen.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: LLM used for the "Without Qloo" baseline and for parsing pasted offer sheets.
# Provided through the Vercel AI Gateway; leave empty to disable the baseline comparison.
AI_GATEWAY_API_KEY=
HEADLINER_BASELINE_MODEL=anthropic/claude-sonnet-5.5

# Where cached Qloo responses live. Never commit the contents.
HEADLINER_CACHE_DIR=.cache/qloo

# Accounts (Supabase Auth: Google, Apple, email). Leave empty to run the desk without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apple sign-in on web needs the Services ID configured in Supabase; keep false until it is.
NEXT_PUBLIC_AUTH_APPLE=false
# Public origin, used for OAuth redirects and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3011

# Contact form delivery (Resend). Without these the form shows the direct address.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=carson@celabe.com

# Share links persist in the headliner Supabase stack through PostgREST (service role, server-side only).
SUPABASE_SERVICE_ROLE_KEY=
